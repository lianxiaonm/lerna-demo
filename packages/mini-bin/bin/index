#!/usr/bin/env node

require('colors')
const cp = require('child_process')
const compareVersions = require('compare-versions')

const nodeVersion = cp.execSync('node --version').toString().trim()
if (compareVersions(nodeVersion, '8.10.0') < 0) {
  console.error('需要 Node.js 版本: v8.10.0+'.red)
  process.exit(1)
}

if (!process.send) require('./start')()
else require('./execute')()

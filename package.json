{
  "name": "mini-build",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "lianxiao.nm",
    "email": "lianxiao.nm@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "lerna bootstrap",
    "build": "yarn clean && lerna run build",
    "watch": "lerna run watch --stream --parallel",
    "rm": "rimraf node_modules && lerna clean",
    "clean": "rimraf packages/*/es && rimraf packages/*/lib",
    "postinstall": "lerna link",
    "precommit": "lint-staged",
    "lint": "npm run lint:js && npm run lint:style",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.less\" --syntax less",
    "example:react": "cd example/react-component && yarn mock"
  },
  "devDependencies": {
    "@babel/cli": "7",
    "@mini-case/babel-preset": "1",
    "@mini-case/eslint-config": "1",
    "@mini-case/bin": "1",
    "colors": "1",
    "consola": "2",
    "eslint": "5",
    "esm": "3",
    "husky": "0",
    "lerna": "3",
    "lint-staged": "8",
    "ncp": "2",
    "stylelint": "10",
    "stylelint-config-standard": "18",
    "rimraf": "2"
  },
  "engines": {
    "node": ">= 8.10.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "lint-staged": {
    "*.js": "eslint",
    "*.less": "stylelint --syntax less"
  }
}

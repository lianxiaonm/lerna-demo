{
  "version": "independent",
  "npmClient": "yarn",
  "useWorkspaces": true,
  "command": {
    "publish": {
      "allowBranch": [
        "master"
      ]
    },
    "version": {
      "allowBranch": [
        "master",
        "beta"
      ],
      "conventionalCommits": true,
      "message": "chore(release): publish version"
    }
  },
  "packages": [
    "packages/*"
  ],
  "changelog": {
    "labels": {
      "feat": "New Feature",
      "fix": "Bug Fix",
      "docs": "Documentation",
      "perf": "Performance",
      "refactor": "Code Refactoring"
    }
  }
}
